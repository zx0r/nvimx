{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'Enterprise CI/CD & Rust Hermetic Toolchain Automation',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigests',
    ':semanticCommits',
    ':dependencyDashboard',
  ],
  timezone: 'UTC',
  schedule: [
    'before 06:00 on monday',
  ],
  minimumReleaseAge: '3 days',
  internalChecksAsSuccess: true,
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: '0 days',
    labels: [
      'security',
      'priority:critical',
    ],
  },
  customDatasources: {
    'rustup-miri-history': {
      defaultRegistryUrlTemplate: 'https://rust-lang.github.io/rustup-components-history/x86_64-unknown-linux-gnu/miri.json',
      format: 'json',
      transformTemplates: [
        '{"releases": [{"version": "nightly-" & last_available}]}',
      ],
    },
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Update pinned Rust CLI developer binaries in taiki-e/install-action',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '(?<depName>cargo-[a-z0-9_-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'crate',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      description: 'Update MIRI_NIGHTLY to the latest verified nightly containing the miri component',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'MIRI_NIGHTLY:\\s*["\'](?<currentValue>nightly-\\d{4}-\\d{2}-\\d{2})["\']',
      ],
      depNameTemplate: 'rust-miri-nightly',
      datasourceTemplate: 'custom.rustup-miri-history',
      versioningTemplate: 'regex:^nightly-(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$',
    },
    {
      customType: 'regex',
      description: 'Track Neovim release tag in workflow environment',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'NVIM_VERSION:\\s*["\'](?<currentValue>v\\d+\\.\\d+\\.\\d+)["\']',
      ],
      depNameTemplate: 'neovim/neovim',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      description: 'Group GitHub Actions SHA digests and CI CLI tools into a single weekly PR',
      matchManagers: [
        'github-actions',
        'custom.regex',
      ],
      groupName: 'ci-toolchain-and-actions',
      groupSlug: 'ci-toolchain',
      labels: [
        'ci',
        'dependencies',
      ],
      matchDepNames: [
        '!neovim/neovim',
      ],
    },
    {
      description: 'Update Neovim version and recalculate NVIM_SHA256 atomically in the same commit',
      matchDepNames: [
        'neovim/neovim',
      ],
      groupName: 'neovim-e2e-runtime',
      labels: [
        'ci',
        'e2e',
      ],
      postUpgradeTasks: {
        commands: [
          'bash -c \'set -euo pipefail; HASH=$(curl -fsSL --retry 3 "https://github.com/neovim/neovim/releases/download/{{{newValue}}}/nvim-linux-x86_64.tar.gz" | sha256sum | awk "{print \\$1}"); sed -i -E "s/(NVIM_SHA256:\\s*[\\"\\x27])[a-f0-9]{64}([\\"\\x27])/\\1${HASH}\\2/g" .github/workflows/*.yml\'',
        ],
        fileFilters: [
          '.github/workflows/*.yml',
          '.github/workflows/*.yaml',
        ],
        executionMode: 'branch',
      },
    },
  ],
}
